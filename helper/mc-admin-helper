#!/usr/bin/env bash
# /usr/local/bin/mc-admin-helper
# Root-owned privileged helper for mcadmin.palvi.org
# Strictly accepts only named actions. No arbitrary commands allowed.

set -euo pipefail

LOG_TAG="mc-admin-helper"
MINECRAFT_STACK_DIR="/opt/stacks/minecraft"
MINECRAFT_DATA_DIR="/opt/containers/minecraft"
BACKUP_DIR="/mnt/media/backups/minecraft"

log() {
    local msg="$1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ${msg}"
    logger -t "${LOG_TAG}" "${msg}"
}

error_exit() {
    local msg="$1"
    echo "[ERROR] ${msg}" >&2
    logger -t "${LOG_TAG}" "ERROR: ${msg}"
    exit 1
}

# Resolve WORLD_NAME dynamically from mc.env LEVEL=, fallback BabaSquadWorld
get_world_name() {
    local world="BabaSquadWorld"
    local env_file="${MINECRAFT_STACK_DIR}/mc.env"
    if [[ -f "${env_file}" ]]; then
        local extracted
        extracted=$(grep -E '^[[:space:]]*LEVEL=' "${env_file}" 2>/dev/null | tail -n 1 | cut -d'=' -f2- | tr -d '\r\n"' | xargs || true)
        if [[ -n "${extracted}" && "${extracted}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
            world="${extracted}"
        fi
    fi
    echo "${world}"
}

# Read command from stdin (single line)
read -r CMD_LINE || true

if [[ -z "${CMD_LINE:-}" ]]; then
    error_exit "No command provided on stdin."
fi

# Split command into action and arguments
read -r ACTION ARG1 REST <<< "${CMD_LINE} "
REST=$(echo "${REST:-}" | xargs)

case "${ACTION}" in
    recreate-mc)
        if [[ -n "${ARG1:-}" || -n "${REST}" ]]; then
            error_exit "recreate-mc accepts no arguments."
        fi

        log "Starting action: recreate-mc"
        
        if [[ ! -d "${MINECRAFT_STACK_DIR}" ]]; then
            error_exit "Minecraft stack directory ${MINECRAFT_STACK_DIR} does not exist."
        fi

        cd "${MINECRAFT_STACK_DIR}"

        # If mc is currently running, save and stop
        MC_STATUS=$(docker inspect -f '{{.State.Status}}' mc 2>/dev/null || echo "not_found")
        if [[ "${MC_STATUS}" == "running" ]]; then
            log "mc is running; sending save-all flush before recreation"
            docker exec mc rcon-cli save-all flush 2>/dev/null || true
            sleep 2
            log "Stopping mc"
            docker stop mc || true
        fi

        log "Step 1/5: docker compose up --no-start mc"
        docker compose up --no-start mc

        log "Step 2/5: docker start mc"
        docker start mc

        log "Step 3/5: waiting 5 seconds..."
        sleep 5

        log "Step 4/5: docker stop mc"
        docker stop mc

        log "Step 5/5: docker restart lazymc"
        docker restart lazymc

        log "recreate-mc sequence completed successfully."
        echo "SUCCESS: recreate-mc completed"
        ;;

    write-env)
        if [[ -z "${ARG1:-}" || -n "${REST}" ]]; then
            error_exit "write-env requires exactly one argument (base64 string)."
        fi

        log "Starting action: write-env"
        b64_payload="${ARG1}"

        # Cap base64 string length to avoid processing oversized payloads (~64 KB limit)
        if (( ${#b64_payload} > 90000 )); then
            error_exit "Payload exceeds maximum allowed size (64 KB)."
        fi

        tmp_file=$(mktemp "${MINECRAFT_STACK_DIR}/mc.env.tmp.XXXXXX")

        # Decode base64
        if ! echo "${b64_payload}" | base64 -d > "${tmp_file}" 2>/dev/null; then
            rm -f "${tmp_file}"
            error_exit "Failed to decode base64 payload."
        fi

        # Check decoded file size <= 65536 bytes
        file_size=$(wc -c < "${tmp_file}")
        if (( file_size > 65536 )); then
            rm -f "${tmp_file}"
            error_exit "Decoded mc.env size (${file_size} bytes) exceeds 64 KB limit."
        fi

        # Validate line by line: every non-empty, non-comment line must match ^[A-Z0-9_]+=[^\r\n]*$
        line_num=0
        while IFS= read -r line || [[ -n "${line}" ]]; do
            line_num=$((line_num + 1))
            line="${line%$'\r'}"
            if [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]]; then
                continue
            fi
            if ! [[ "${line}" =~ ^[A-Z0-9_]+=[^$'\r'$'\n']*$ ]]; then
                rm -f "${tmp_file}"
                error_exit "Line ${line_num} violates mc.env syntax: invalid key or illegal characters."
            fi
        done < "${tmp_file}"

        chmod 0644 "${tmp_file}"
        chown 1000:1000 "${tmp_file}" 2>/dev/null || true

        # Write timestamped backup of current mc.env
        target_env="${MINECRAFT_STACK_DIR}/mc.env"
        timestamp=$(date '+%Y%m%d_%H%M%S')
        if [[ -f "${target_env}" ]]; then
            cp -p "${target_env}" "${MINECRAFT_STACK_DIR}/mc.env.bak-${timestamp}"
            log "Created backup: mc.env.bak-${timestamp}"
        fi

        # Atomically replace mc.env
        mv -f "${tmp_file}" "${target_env}"
        log "mc.env successfully updated."
        echo "SUCCESS: mc.env updated (backup: mc.env.bak-${timestamp})"
        ;;

    set-grace)
        if [[ -z "${ARG1:-}" || -n "${REST}" ]]; then
            error_exit "set-grace requires exactly one argument (integer seconds)."
        fi

        # Validate that ARG1 is an integer between 60 and 3600
        if ! [[ "${ARG1}" =~ ^[0-9]+$ ]]; then
            error_exit "Invalid grace value: '${ARG1}'. Must be an integer."
        fi

        GRACE_VAL=$((ARG1))
        if (( GRACE_VAL < 60 || GRACE_VAL > 3600 )); then
            error_exit "Grace value must be between 60 and 3600 seconds (got ${GRACE_VAL})."
        fi

        log "Setting mc-watch grace period to ${GRACE_VAL}s"

        DROPIN_DIR="/etc/systemd/system/mc-watch.service.d"
        mkdir -p "${DROPIN_DIR}"

        cat <<EOF > "${DROPIN_DIR}/override.conf"
[Service]
Environment="GRACE=${GRACE_VAL}"
EOF

        systemctl daemon-reload
        systemctl restart mc-watch

        log "mc-watch grace updated to ${GRACE_VAL}s and service restarted."
        echo "SUCCESS: grace set to ${GRACE_VAL}s"
        ;;

    start-media)
        if [[ -n "${ARG1:-}" || -n "${REST}" ]]; then
            error_exit "start-media accepts no arguments."
        fi

        log "Starting action: start-media now"
        
        if [[ -x "/usr/local/bin/media-start" ]]; then
            /usr/local/bin/media-start
            log "media-start executed. Restarting mc-watch to cancel any pending grace timer and refresh state."
            systemctl restart mc-watch
            log "mc-watch restarted."
            echo "SUCCESS: media-start executed and mc-watch restarted"
        else
            error_exit "/usr/local/bin/media-start script not found or not executable."
        fi
        ;;

    backup)
        if [[ -n "${ARG1:-}" || -n "${REST}" ]]; then
            error_exit "backup accepts no arguments."
        fi

        log "Starting action: backup"
        WORLD_NAME=$(get_world_name)
        mkdir -p "${BACKUP_DIR}"

        TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
        BACKUP_FILE="${BACKUP_DIR}/world_${TIMESTAMP}.tar.gz"

        MC_STATUS=$(docker inspect -f '{{.State.Status}}' mc 2>/dev/null || echo "not_found")
        ONLINE=false
        if [[ "${MC_STATUS}" == "running" ]]; then
            ONLINE=true
            log "Server is running: holding world save during backup"
            docker exec mc rcon-cli save-off || true
            trap 'docker exec mc rcon-cli save-on || true' EXIT
            docker exec mc rcon-cli save-all flush || true
            sleep 1
        fi

        log "Creating archive ${BACKUP_FILE} from ${MINECRAFT_DATA_DIR}/${WORLD_NAME}"
        if [[ ! -d "${MINECRAFT_DATA_DIR}/${WORLD_NAME}" ]]; then
            error_exit "World folder ${MINECRAFT_DATA_DIR}/${WORLD_NAME} not found."
        fi

        tar -czf "${BACKUP_FILE}" -C "${MINECRAFT_DATA_DIR}" "${WORLD_NAME}"

        if [[ "${ONLINE}" == "true" ]]; then
            trap - EXIT
            docker exec mc rcon-cli save-on || true
            log "Server world saving resumed (save-on)."
        fi

        BACKUP_SIZE=$(du -sh "${BACKUP_FILE}" | cut -f1)
        log "Backup completed: ${BACKUP_FILE} (${BACKUP_SIZE})"

        # Retain last 7 backups, purge older world_*.tar.gz
        log "Pruning old backups in ${BACKUP_DIR} (retaining last 7)..."
        # shellcheck disable=SC2012
        OLD_BACKUPS=$(ls -1t "${BACKUP_DIR}"/world_*.tar.gz 2>/dev/null | tail -n +8 || true)
        if [[ -n "${OLD_BACKUPS}" ]]; then
            echo "${OLD_BACKUPS}" | xargs rm -f
            log "Pruned old backups."
        fi

        echo "SUCCESS: backup created world_${TIMESTAMP}.tar.gz (${BACKUP_SIZE})"
        ;;

    restore)
        if [[ -z "${ARG1:-}" || -n "${REST}" ]]; then
            error_exit "restore requires exactly one argument (backup ID)."
        fi

        BACKUP_ID="${ARG1}"
        # Validate backup ID: only letters, numbers, underscores, dashes, and optional .tar.gz
        if ! [[ "${BACKUP_ID}" =~ ^[a-zA-Z0-9_-]+(\.tar\.gz)?$ ]]; then
            error_exit "Invalid backup ID: '${BACKUP_ID}'. Must be alphanumeric."
        fi

        if [[ "${BACKUP_ID}" != *.tar.gz ]]; then
            BACKUP_FILE="${BACKUP_DIR}/${BACKUP_ID}.tar.gz"
        else
            BACKUP_FILE="${BACKUP_DIR}/${BACKUP_ID}"
        fi

        if [[ ! -f "${BACKUP_FILE}" ]]; then
            error_exit "Backup file ${BACKUP_FILE} does not exist."
        fi

        # Minecraft MUST be stopped before restore
        MC_STATUS=$(docker inspect -f '{{.State.Status}}' mc 2>/dev/null || echo "not_found")
        if [[ "${MC_STATUS}" == "running" ]]; then
            error_exit "Cannot restore while Minecraft is running! Stop the server first."
        fi

        log "Starting restore for ${BACKUP_ID}"
        WORLD_NAME=$(get_world_name)

        # Safety backup of current world before replacing
        SAFETY_TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
        SAFETY_BACKUP="${BACKUP_DIR}/safety_before_restore_${SAFETY_TIMESTAMP}.tar.gz"
        if [[ -d "${MINECRAFT_DATA_DIR}/${WORLD_NAME}" ]]; then
            log "Creating safety backup before restore: ${SAFETY_BACKUP}"
            tar -czf "${SAFETY_BACKUP}" -C "${MINECRAFT_DATA_DIR}" "${WORLD_NAME}"
            log "Safety backup created."
        fi

        # Remove old world folder and extract
        log "Removing old world folder ${MINECRAFT_DATA_DIR}/${WORLD_NAME}"
        rm -rf "${MINECRAFT_DATA_DIR:?}/${WORLD_NAME}"

        log "Extracting ${BACKUP_FILE} to ${MINECRAFT_DATA_DIR}"
        tar -xzf "${BACKUP_FILE}" -C "${MINECRAFT_DATA_DIR}"

        # Fix ownership
        chown -R 1000:1000 "${MINECRAFT_DATA_DIR}/${WORLD_NAME}" 2>/dev/null || true

        log "Restore completed successfully for ${BACKUP_ID}."
        echo "SUCCESS: restore completed for ${BACKUP_ID}"
        ;;

    *)
        error_exit "Unknown action: '${ACTION}'. Allowed actions: recreate-mc, write-env, set-grace, start-media, backup, restore."
        ;;
esac
